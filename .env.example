# Copy this file to `.env` and adjust. `.env` is git-ignored; never commit real secrets.
# These defaults are for LOCAL DEVELOPMENT ONLY.

# --- Django ---
# Generate a real one with:  python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=dev-only-insecure-placeholder-change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# --- PostgreSQL (used by the postgres container and by Django) ---
POSTGRES_DB=trax
POSTGRES_USER=trax
POSTGRES_PASSWORD=trax-dev-password
# Inside Docker the database host is the service name "postgres".
DATABASE_URL=postgres://trax:trax-dev-password@postgres:5432/trax

# --- Redis / Celery ---
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- Auth (JWT lifetimes) ---
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# --- CORS: which browser origins may call the API ---
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Frontend ---
# Where the browser reaches the API (the browser runs on your PC, so localhost, not "backend").
NEXT_PUBLIC_API_URL=http://localhost:8000
